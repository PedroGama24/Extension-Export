{
  "manifest_version": 3,
  "name": "Exportação Automática de CSV",
  "version": "1.0.0",
  "description": "Automatize a exportação de arquivos CSV de múltiplos dias no Oracle Cloud (Alloha).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "activeTab", "downloads"],
  "host_permissions": ["https://alloha.fs.ocs.oraclecloud.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exportação Automática de CSV",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://alloha.fs.ocs.oraclecloud.com/*"],
      "js": ["content.js"]
    }
  ]
}
